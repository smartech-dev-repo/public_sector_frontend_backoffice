# --- Build-time (inlined into the browser bundle; changing them needs a rebuild) ---
# Dokploy: set under "Build-time Arguments" (docker build --build-arg ...)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_IMAGE_UPLOAD_BASE_URL=https://api.example.com/uploads

# --- Runtime (read when the container / `npm start` / `npm run preview` starts) ---
# Dokploy: set under "Environment"; keep the domain's container port equal to PORT
PORT=3000
HOSTNAME=0.0.0.0

# --- Dokploy Preview Deployments (Application → Preview Deployments tab) ---
# Previews read their own Environment / Build-time Arguments, not the ones above.
# Paste this block there, pointing at a staging API:
#   Build Args:  NEXT_PUBLIC_API_BASE_URL=https://staging-api.example.com
#                NEXT_PUBLIC_IMAGE_UPLOAD_BASE_URL=https://staging-api.example.com/uploads
#   Environment: PORT=3000
#                HOSTNAME=0.0.0.0
#   Port field:  3000   (must equal PORT above)
#   Wildcard domain: *.preview.example.com  (or *.traefik.me for testing)
