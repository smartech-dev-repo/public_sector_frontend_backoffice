# What may be committed is enforced by scripts/check-repo-files.mjs (pre-commit hook + CI).
# This file keeps the usual offenders out of `git status` in the first place.

# Dependencies
node_modules/

# Next.js build output and caches
.next/
out/
build/
*.tsbuildinfo

# Old Nuxt output
.nuxt/
.output/
.nitro/
.data/
dist/

# Tool and test caches
.cache/
.turbo/
.vercel/
.kilo/
coverage/

# Env files: only the example is committed
.env
.env.*
!.env.example

# Secrets and keys
*.pem
*.key
*.p12
*.pfx

# Exports, dumps and archives (Postman exports live in the backend repo)
*.postman_collection*.json
*.postman_environment*.json
*.csv
*.xlsx
*.xls
*.sql
*.zip
*.tar.gz

# Scratch scripts and notes at the repo root (config files are allowed back in below)
/*.js
/*.cjs
/*.mjs
/*.json
/*.txt
*.py
*.txt
!/tailwind.config.js
!/next.config.mjs
!/postcss.config.mjs
!/eslint.config.mjs
!/package.json
!/package-lock.json
!/tsconfig.json

# Logs and OS/editor files
logs/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.fleet/
